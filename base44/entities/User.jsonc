{
  "name": "User",
  "type": "object",
  "properties": {
    "detective_name": {
      "type": "string",
      "description": "\u73a9\u5bb6\u4fa6\u63a2\u4ee3\u53f7"
    },
    "avatar": {
      "type": "string",
      "description": "\u4fa6\u63a2\u5934\u50cf\uff08emoji\uff09"
    },
    "signature": {
      "type": "string",
      "description": "\u4fa6\u63a2\u4e2a\u6027\u7b7e\u540d"
    },
    "identity_badge": {
      "type": "string",
      "description": "\u4fa6\u63a2\u8eab\u4efd\u5fbd\u7ae0"
    },
    "detective_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "rank_title": {
      "type": "string",
      "default": "\u65b0\u624b\u4fa6\u63a2"
    },
    "energy": {
      "type": "number",
      "default": 120
    },
    "energy_updated_at": {
      "type": "string"
    },
    "diamonds": {
      "type": "number",
      "default": 0
    },
    "gold": {
      "type": "number",
      "default": 0
    },
    "last_checkin": {
      "type": "string"
    },
    "checkin_streak": {
      "type": "number",
      "default": 0
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "solved_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsolved_count": {
      "type": "number",
      "default": 3
    },
    "rename_count": {
      "type": "number",
      "default": 0
    },
    "checkin_history": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inventory": {
      "type": "object",
      "properties": {
        "energy_cell": { "type": "number", "default": 0 },
        "ap_booster": { "type": "number", "default": 0 },
        "firewall_shield": { "type": "number", "default": 0 },
        "clue_scanner": { "type": "number", "default": 0 }
      }
    },
    "equipped_items": { "type": "array", "items": { "type": "string" } },
    "tech_unlocks": { "type": "array", "items": { "type": "string" } },
    "case_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": { "type": "string" },
          "difficulty": { "type": "string" },
          "attempts": { "type": "number" },
          "solves": { "type": "number" },
          "best_score": { "type": "string" },
          "best_turns": { "type": "number" },
          "lowest_confusion": { "type": "number" },
          "discovered_clues": { "type": "array", "items": { "type": "string" } },
          "valid_links": { "type": "array", "items": { "type": "string" } },
          "last_played_at": { "type": "string" }
        }
      }
    },
    "activity_stats": {
      "type": "object",
      "properties": {
        "cases_started": { "type": "number", "default": 0 },
        "cases_solved": { "type": "number", "default": 0 },
        "valid_links": { "type": "number", "default": 0 },
        "invalid_links": { "type": "number", "default": 0 },
        "reports_submitted": { "type": "number", "default": 0 },
        "bsod_runs": { "type": "number", "default": 0 },
        "team_saved": { "type": "number", "default": 0 },
        "lobby_visits": { "type": "number", "default": 0 },
        "best_agent_level": { "type": "number", "default": 0 },
        "all_agents_min_level": { "type": "number", "default": 0 },
        "best_score_value": { "type": "number", "default": 0 }
      }
    },
    "reward_claims": { "type": "array", "items": { "type": "string" } },
    "journey_started_on": { "type": "string" },
    "mail_read_ids": { "type": "array", "items": { "type": "string" } },
    "mail_reply_choices": { "type": "array", "items": { "type": "string" } },
    "rewarded_runs": { "type": "array", "items": { "type": "string" } },
    "agent_progression": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "xp": { "type": "number", "default": 0 }
        }
      }
    },
    "skill_loadout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": { "type": "string" },
          "skill_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "saved_team_config": {
      "type": "object",
      "properties": {
        "specs": { "type": "array", "items": { "type": "object" } },
        "priorities": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "primary_agent_index": { "type": "number", "default": 1 }
      }
    },
    "profile_revision": { "type": "number", "default": 0 },
    "active_session_id": { "type": "string" },
    "weekly_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cycle_id": { "type": "string" },
          "case_id": { "type": "string" },
          "passed": { "type": "boolean" },
          "clue_target": { "type": "boolean" },
          "speed_target": { "type": "boolean" }
        }
      }
    },
    "home_progress_version": {
      "type": "number",
      "default": 2
    }
  }
}
