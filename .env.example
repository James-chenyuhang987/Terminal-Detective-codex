# Terminal Detective — local development environment
#
# Copy this file to `.env.local` (which is git-ignored) before running `npm run dev`:
#
#   cp .env.example .env.local
#
# These values belong to the NEW Terminal Detective Base44 app.
# Do NOT reuse the .env.local from any older/previous app — the app id differs,
# so the old one will read the wrong database and auth settings.

# The Base44 app id for Terminal Detective.
VITE_BASE44_APP_ID=6a841dff26d5042e4adf890e

# The public base URL of this app.
# Find it in the Base44 dashboard: Settings -> your app's URL
# (looks like https://<your-app-name>.base44.app).
VITE_BASE44_APP_BASE_URL=

# Optional — only needed if you are pinning a specific backend functions version.
# VITE_BASE44_FUNCTIONS_VERSION=