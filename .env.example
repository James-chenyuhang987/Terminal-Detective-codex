# Terminal Detective — local development environment
#
# Copy this file to `.env.local` (which is git-ignored) before running `npm run dev`:
#
#   cp .env.example .env.local
#
# These values are public connection settings, not API keys.

# The Base44 app id for Terminal Detective.
VITE_BASE44_APP_ID=6a841dff26d5042e4adf890e

# Hosted Base44 API used by external frontends such as GitHub Pages.
VITE_BASE44_SERVER_URL=https://base44.app

# Optional hosted login/logout base. Defaults to VITE_BASE44_SERVER_URL.
# VITE_BASE44_APP_BASE_URL=https://base44.app

# Optional Vite public path. GitHub Actions derives /<repository>/ automatically.
# VITE_BASE_PATH=/Terminal-Detective-codex/

# Optional — only needed if you are pinning a specific backend functions version.
# VITE_BASE44_FUNCTIONS_VERSION=
