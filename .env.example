# Terminal Detective — local development environment
#
# Copy this file to `.env.local` before running `npm run dev`.
# These are public connection settings, not credentials.

VITE_APP_ID=terminal-detective

# The Cloudflare deployment uses the same origin for UI and API.
# Use the hosted Worker URL when the UI is served elsewhere.
VITE_API_SERVER_URL=same-origin
# VITE_API_SERVER_URL=https://terminal-detective-codex.terminal-detective.workers.dev

# Firebase Web App public configuration. These values identify the Firebase
# project; they are safe in the browser and are protected by Firebase rules and
# authorized-domain settings. Do not put service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional Vite public path for GitHub Pages.
# VITE_BASE_PATH=/Terminal-Detective-codex/

# Worker configuration (not a frontend VITE_ value): set FIREBASE_PROJECT_ID
# and the comma-separated CORS_ALLOWED_ORIGINS in wrangler.jsonc or the
# Cloudflare dashboard. CORS entries are exact frontend origins without paths.
# The Worker does not need a Firebase service-account private key.
