{
  "name": "terminal-detective",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare": "VITE_API_SERVER_URL=same-origin VITE_BASE_PATH=/ vite build && node scripts/prepare-cloudflare-build.mjs",
    "cloudflare:check": "npm run build:cloudflare && wrangler deploy --dry-run",
    "cloudflare:dev": "npm run build:cloudflare && wrangler dev",
    "cloudflare:deploy": "npm run build:cloudflare && wrangler deploy",
    "cloudflare:d1:local": "wrangler d1 migrations apply terminal-detective-prod --local",
    "cloudflare:d1:remote": "wrangler d1 migrations apply terminal-detective-prod --remote",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "security:check": "node scripts/security-check.mjs",
    "typecheck": "tsc -p ./jsconfig.json",
    "test": "node --test tests/*.test.js",
    "assets:cinematics": "node scripts/generate-cinematic-props.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "firebase": "12.18.0",
    "jose": "6.2.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.168.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.5",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "15.14.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "wrangler": "4.127.1"
  }
}
